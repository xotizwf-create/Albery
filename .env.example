BITRIX_WEBHOOK_BASE=https://yourcompany.bitrix24.ru/rest/1/xxxxxxxxxxxx/
FLASK_SECRET_KEY=replace-with-random-string
ADMIN_PASSWORD_HASH=
AUTH_SESSION_DAYS=30
AUTH_RATE_LIMIT_ATTEMPTS=6
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CANONICAL_WEB_HOST=
MCP_HOST=
# Public HTTPS base used by Hermes for per-agent MCP connectors. Keep it explicit: the
# provisioner refuses to guess a production host.
AGENT_MCP_PUBLIC_BASE=

# Standalone «Работа с воронками» operator workspace. The password is stored only as a
# Werkzeug hash (generate_password_hash); never put the plaintext password in this file.
# The feature flag keeps the new Telegram routing dormant until its end-to-end smoke passes.
FUNNEL_WORKSPACE_ENABLED=0
FUNNEL_WORKSPACE_PASSWORD_HASH=
FUNNEL_WORKSPACE_AUTH_SESSION_DAYS=30
FUNNEL_WORKSPACE_AUTH_RATE_LIMIT_ATTEMPTS=6
FUNNEL_WORKSPACE_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
FUNNEL_WORKSPACE_HUMAN_LEASE_SECONDS=120
# Telegram Business allows replies only inside a finite window. Keep this explicit so the UI
# and delivery guard show the same deadline (the implementation accepts 1..48 hours).
FUNNEL_WORKSPACE_REPLY_WINDOW_HOURS=24
FUNNEL_WORKSPACE_RETENTION_DAYS=90
# Публичный адрес сайта для ссылок вида https://.../agent-funnels/<id> в напоминаниях.
# Только для ссылок: CANONICAL_WEB_HOST для этого не годится — он включает 301 на
# канонический домен и ломает локальные вызовы (в том числе внутренние MCP по 127.0.0.1).
FUNNEL_WORKSPACE_PUBLIC_BASE=
# Private Bitrix recipient of the instant "client called a manager" alert and
# the IU bot profile used as its author. Production defaults: Alexander Nikitenko / IU agent.
IU_MANAGER_NOTIFY_BITRIX_USER_ID=16
IU_AGENT_BOT_ID=86
# Durable lead-response monitor. It alerts at 10/30/60 minutes only from
# 09:00 through 18:00 MSK and sends the overnight priority queue next morning.
IU_MANAGER_RESPONSE_WATCH_ENABLED=1
IU_MANAGER_RESPONSE_WATCH_POLL_SECONDS=30
# Единственный документ, который читает клиентский ИИ.
IU_AGENT_QA_DOC=Вопрос - ответ для Агента
# Клиентские документы, которые отправляются вложениями и не читаются агентом.
IU_BOT_TERMS_DOCUMENT=Условия ИУ — текст для клиента
IU_BOT_CONTRACT_DOCUMENT=Договор оферты
IU_BOT_FAQ_DOCUMENT=Ответы на частые вопросы
# Этапы сделки меняют только явные действия человека или MCP-инструмента ИИ.
# Все неявные переходы из ответов/файлов остаются выключены. Единственное исключение —
# подтверждённая склейка анкеты: NEW → «Анкета».
IU_AUTOMATIC_STAGE_TRANSITIONS_ENABLED=0
IU_FORM_STAGE_TRANSITION_ENABLED=1
# Через сколько минут без ответа обращение считается срочным.
FUNNEL_WORKSPACE_URGENT_AFTER_MINUTES=10
FUNNEL_WORKSPACE_AI_ENABLED=0
# Comma-separated Telegram IDs for a test rollout. Empty = nobody; use * only after approval.
FUNNEL_WORKSPACE_AI_ALLOW_IDS=
# Existing Albery agent profile used for role/tone. Its broad tool connector is never exposed
# to customer text: side effects are performed only by deterministic workspace workers.
FUNNEL_WORKSPACE_AGENT_SLUG=agent-po-rabote-s-iu
# A dedicated manifest-capped zero-tool connector for untrusted prompts. It has no Telegram or
# Bitrix bridge; scripts/ensure_workspace_customer_connector.py provisions it during deploy.
FUNNEL_WORKSPACE_CUSTOMER_TOOLSET_SLUG=iu-customer-runtime
FUNNEL_WORKSPACE_AI_DEBOUNCE_MS=1200
FUNNEL_WORKSPACE_OUTBOX_POLL_SECONDS=1
FUNNEL_WORKSPACE_JOB_POLL_SECONDS=1
# Optional dedicated Bitrix UF for the immutable numeric Telegram user ID. Do not invent an
# ID: leave empty until the field exists on the portal. The workspace still recovers a deal by
# its stable [tg:<id>] marker. If set, it must differ from legacy CRM_TELEGRAM_FIELD (username).
FUNNEL_WORKSPACE_CRM_TELEGRAM_ID_FIELD=
# Cutover invariant: the custom workspace must be the only Telegram responder.
# The Bitrix open line was removed from the system on 2026-07-27 — it duplicated leads
# through the Wazzup connector. OPENLINE_AGENT_ENABLED / B24_OPENLINE_BOT_ID must not
# come back: deploy smoke fails if either is present.
TG_BUSINESS_AUTOREPLY=0

BITRIX_EXPORT_MODE=audit
BITRIX_REQUEST_DELAY=0.05
BITRIX_LOOKBACK_DAYS=30
AUTO_SYNC_BITRIX_LOOKBACK_DAYS=30
BITRIX_EVENT_SECRET=replace-with-random-event-secret
BITRIX_TASK_EVENT_PROCESS_INLINE=1
AUTO_SYNC_CHAT_LOOKBACK_DAYS=1
AUTO_SYNC_CHAT_GENERATE_REPORTS=0
AUTO_SYNC_ZOOM_FROM=2026-01-01
AUTO_SYNC_ZOOM_TO=
AUTO_SYNC_GOOGLE_DRIVE_ZOOM_TRANSCRIPTS=1
ZOOM_EVENT_SECRET=replace-with-random-zoom-event-secret
ZOOM_WEBHOOK_SECRET_TOKEN=replace-with-zoom-marketplace-secret-token
ZOOM_EVENT_PROCESS_INLINE=1

# PostgreSQL connection for the new schema.
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_analytics
DATABASE_URL=
# Optional admin/owner connection used only by scripts/ensure_postgres.py for DDL migrations.
DATABASE_ADMIN_URL=

# Optional protection for public MCP endpoint.
# Use https://host/mcp/<this-secret> in Claude Web custom connector,
# or send Authorization: Bearer <this-secret>.
# HTTP MCP is disabled without this secret unless MCP_ALLOW_UNAUTHENTICATED=1.
MCP_SHARED_SECRET=
MCP_ALLOW_UNAUTHENTICATED=0
# Separate read-only MCP endpoint for regulations/company knowledge, Zoom calls, and org structure only.
# Use https://host/mcp-faq/<this-secret> or Authorization: Bearer <this-secret>.
MCP_FAQ_SHARED_SECRET=

# LLM provider (OpenAI-compatible endpoint or Google AI Studio)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OWNER_DAILY_MODEL=gpt-5.5
OWNER_WEEKLY_MODEL=gpt-5.5
OPENAI_CONTRACT_MODEL=gpt-4.1-mini
OPENAI_API_MODE=responses
# 2 GB production host: three Hermes turns are the measured safe ceiling.
FUNNEL_WORKSPACE_AI_WORKERS=3
TG_AGENT_PARALLEL_TURNS=3
OPENAI_TIMEOUT_SECONDS=120

# Telegram agent trust boundaries. Customer turns always use the fail-closed
# agent-albery-ai-bot connector; this separate value is only read after is_owner().
TG_AGENT_OWNER_TOOLSETS=albery,web

# Optional explicit Google variables (used as fallbacks)

# Google Drive -> "О компании" sync through Google Apps Script web app.
GOOGLE_APPS_SCRIPT_SYNC_URL=
GOOGLE_APPS_SCRIPT_SYNC_TOKEN=
GOOGLE_DRIVE_COMPANY_ROOT_NAME=Google Drive
GOOGLE_DRIVE_SYNC_TIMEOUT_SECONDS=600

# Near-realtime company Drive sync. The Apps Script change trigger pings
# https://mcp.m4s.ru/google-drive/events/<GOOGLE_DRIVE_EVENT_SECRET> when the
# watched folder changes; the same secret must be set in Code.gs (CHANGE_NOTIFY_URL).
GOOGLE_DRIVE_EVENT_SECRET=replace-with-random-google-drive-event-secret
GOOGLE_DRIVE_EVENT_PROCESS_INLINE=1

# Google Drive call transcripts sync. Reads only transcript.txt files.
# Optional: if empty, the backend uses GOOGLE_APPS_SCRIPT_SYNC_URL and GOOGLE_APPS_SCRIPT_SYNC_TOKEN.
GOOGLE_CALLS_APPS_SCRIPT_SYNC_URL=
GOOGLE_CALLS_APPS_SCRIPT_SYNC_TOKEN=
