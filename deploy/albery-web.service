[Unit]
# Роль ВЕБ: сайт, API, Центр Агента, отчёты. Отделена от роли бота 07.08.2026, чтобы
# зависший ход мозга (до 10 минут в отдельном процессе hermes) не задерживал выдачу страниц
# и API. Фоновые расписания здесь НЕ крутятся — они за ALBERY_ROLE, см. shared/role.py.
Description=Albery web/API (gunicorn, role=web)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/albery
Environment=ALBERY_ROLE=web
# Работа здесь почти вся — ожидание базы и Битрикса, а не счёт, поэтому потоки дешевле
# процессов на коробке с 2 ГБ.
#
# Воркер ОДИН, потоков восемь. Двух воркеров на роль коробка не тянет: 07.08.2026 после
# разделения свободной памяти осталось 747 МБ при пиковой потребности 750 МБ на три
# одновременных хода мозга (~250 МБ каждый) — запас исчез полностью, до разделения он
# был около 360 МБ. Главное, ради чего делалось разделение — изоляция ролей друг от
# друга — от числа воркеров ВНУТРИ роли не зависит.
#
# --preload НЕ ставить. Он был здесь 07.08.2026 ради экономии памяти и положил Центр Агента:
# приложение обращается к базе уже НА ИМПОРТЕ (ensure_builtin_telegram_agents и другие),
# поэтому пул psycopg успевал создаться в мастере ДО раздвоения. Пул раздвоения не переживает:
# воркеры получали пул, ссылающийся на чужие соединения, и каждый запрос падал через 30 секунд
# с PoolTimeout. Без --preload каждый воркер импортирует приложение сам и заводит собственный
# пул — раздвоения нет вовсе. Цена — около 55 МБ на воркера, она заложена.
ExecStart=/var/www/albery/.venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --bind 127.0.0.1:5003 \
    --timeout 620 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
# 620 с против 600 с у nginx: воркер должен умирать ПОЗЖЕ, чем прокси отдаст таймаут клиенту,
# иначе пользователь получит 502 вместо честного таймаута.
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
