@echo off
chcp 65001 >nul
title Подключение аккаунта Авито
cd /d "%~dp0.."

echo.
echo   ПОДКЛЮЧЕНИЕ АККАУНТА АВИТО
echo   ---------------------------------------------------------------
echo   Сейчас откроется окно браузера. В нём нужно:
echo     1. пройти капчу, если попросят;
echo     2. войти в свой аккаунт Авито;
echo     3. ввести код из SMS.
echo.
echo   Остальное программа сделает сама. Окно браузера не закрывайте.
echo   ---------------------------------------------------------------
echo.

python scripts\avito_worker.py connect %*

echo.
if errorlevel 1 (
  echo   Подключить не удалось. Запустите этот файл ещё раз.
) else (
  echo   Готово. Аккаунт подключён.
)
echo.
pause
